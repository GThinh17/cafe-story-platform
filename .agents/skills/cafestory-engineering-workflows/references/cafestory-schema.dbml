Project cafe_story_platform {
  database_type: "PostgreSQL"
  Note: "Reverse-engineered from the JPA entities under 1-cafe-story-backend-javaspring/src/main/java/com/cafestory/entity. String enums (@Enumerated(EnumType.STRING)) are represented as DBML enums here; the underlying Postgres column is varchar unless noted. Only admin_payout.status uses a native Postgres NAMED_ENUM. created_at / updated_at are populated in @PrePersist / @PreUpdate (application-side), not by DB defaults."
}

// =============================================================================
// ENUMS
// =============================================================================

Enum actor_context_type {
  USER
  CAFE_PAGE
}

Enum ad_fee_type {
  FEED_10000_IMPRESSIONS_OR_30_DAYS
}

Enum ad_status {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
}

Enum admin_assistant_draft_action_status {
  PENDING
  EXECUTED
  CANCELLED
  EXPIRED
  FAILED
}

Enum admin_assistant_draft_action_type {
  REPORT_RESOLVE
  REPORT_REJECT
  REPORT_ASK_AI_RESOLUTION
  REPORT_CANCEL_AUTO_APPLY
  BLOG_HIDE
  BLOG_REMOVE
  COMMENT_HIDE
  COMMENT_REMOVE
  USER_DEACTIVATE
  CAFE_PAGE_SUSPEND
}

Enum admin_assistant_message_role {
  USER
  ASSISTANT
  SYSTEM
}

Enum admin_assistant_tool_call_status {
  SUCCESS
  FAILED
}

Enum admin_payout_status {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

Enum admin_report_ai_auto_apply_job_status {
  SCHEDULED
  APPLYING
  APPLIED
  CANCELLED
  FAILED
  SKIPPED
}

Enum admin_report_ai_report_decision {
  RESOLVE
  REJECT
  NEEDS_MANUAL_REVIEW
}

Enum admin_report_ai_target_action {
  APPROVE
  HIDE
  REMOVE
  KEEP_ACTIVE
  SUSPEND_USER
  SUSPEND_PAGE
  NONE
}

Enum blog_event_type {
  VIEW
  LIKE
  COMMENT
  SHARE
  SAVE
  REPORT
}

Enum chat_sender_context_type {
  USER
  CAFE_PAGE
}

Enum chat_target_type {
  USER
  CAFE_PAGE
  GROUP
}

Enum conversation_type {
  DIRECT
  CAFE_PAGE
  GROUP
}

Enum extra_fee_type {
  REVIEWER_REGISTRATION
  CAFE_PAGE_OPENING
}

Enum feed_item_type {
  USER_BLOG
  CAFE_PAGE_BLOG
  SPONSORED_CAFE
}

Enum follow_target_filter {
  ALL
  USER
  CAFE_PAGE
}

Enum follow_target_type {
  USER
  CAFE_PAGE
}

Enum member_role {
  OWNER
  ADMIN
  MEMBER
}

Enum message_status {
  SENT
  FAILED
  DELETED
}

Enum message_type {
  TEXT
  IMAGE
  STICKER
  MIXED
}

Enum moderation_decision {
  SAFE
  NEEDS_REVIEW
  VIOLATION
}

Enum moderation_resolve_action {
  APPROVE
  HIDE
  REMOVE
}

Enum notification_target_type {
  BLOG
  CONVERSATION
  USER
  CAFE_PAGE
}

Enum notification_type {
  LIKE
  SHARE
  COMMENT
  MESSAGE
  FOLLOW
  TAG
  BLOG_MODERATION
}

Enum page_member_status {
  PENDING
  ACTIVE
  REJECTED
}

Enum page_status {
  DRAFT
  ACTIVE
  SUSPENDED
}

Enum payment_method {
  STRIPE_CARD
  BANK_TRANSFER
  VNPAY
}

Enum payment_status {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

Enum payout_status {
  CALCULATED
  PAID
  CANCELLED
}

Enum post_status {
  DRAFT
  PUBLISHED
  HIDDEN
  REMOVED
}

Enum ranking_period_type {
  DAILY
  WEEKLY
  MONTHLY
}

Enum recommendation_target_type {
  USER
  REVIEWER
  CAFE_PAGE
}

Enum region_requirement {
  BLOG_LOCATION
  FULL_ADDRESS
}

Enum report_moderation_job_status {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  DEAD_LETTER
}

Enum report_status {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

Enum report_target_type {
  BLOG
  COMMENT
  USER
  CAFE_PAGE
}

Enum reviewer_badge {
  IRON
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

Enum share_type {
  PUBLIC
  PRIVATE
  PAGE_ONLY
}

Enum trend_window_type {
  HOUR_24
  DAY_7
  MONTH_1
}

// =============================================================================
// USER & AUTH
// =============================================================================

Table users {
  user_id uuid [pk]
  user_name varchar(255)
  user_full_name varchar(255)
  user_password varchar(255)
  user_email varchar(255) [unique]
  user_phone bigint
  user_avatar varchar(255)
  user_description text
  region_id uuid
  user_like int [not null, default: 0]
  user_follower int [not null, default: 0]
  account_status boolean [not null, default: true]
  hide_cafe_page_on_profile boolean [not null, default: false]

  Note: "user_like and user_follower are cached counters maintained by services; blog_likes / user_follows are the source of truth. account_status=false means the account is disabled."
}

Table roles {
  id int [pk, increment]
  name varchar(60) [not null, unique]
  Note: "Seeded values: USER, REVIEWER, ADMIN, CAFE_PAGE (see RoleDataInitializer)."
}

Table user_roles {
  user_id uuid [not null]
  role_id int [not null]
  created_at datetime [not null]

  Indexes {
    (user_id, role_id) [pk]
  }
}

Table refresh_tokens {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar(64) [not null, unique]
  expires_at datetime [not null]
  revoked_at datetime
  created_at datetime [not null]

  Indexes {
    (user_id)
    (expires_at)
  }

  Note: "Stores SHA-256 hashes only; raw refresh token is sent to clients via HttpOnly cookie and never persisted."
}

Table user_follows {
  id uuid [pk]
  follower_user_id uuid [not null]
  following_user_id uuid [not null]
  created_at datetime [not null]

  Indexes {
    (follower_user_id, following_user_id) [unique]
    (follower_user_id, created_at)
    (following_user_id, created_at)
  }

  Note: "Application check: follower_user_id <> following_user_id."
}

// =============================================================================
// REGION
// =============================================================================

Table regions {
  region_id uuid [pk]
  province_code varchar(16)
  city_code varchar(16)
  ward_code varchar(16)
  province varchar(255)
  city varchar(255)
  ward varchar(255)
  area varchar(255)
  street varchar(255)
  created_at datetime [not null]
  updated_at datetime

  Note: "Denormalized address snapshot table. *_code point to region_provinces / region_cities / region_wards; text columns keep display copies. Blog locations only require province+city; user and cafe_page addresses require province+city+ward+street."
}

Table region_provinces {
  province_code varchar(16) [pk]
  name varchar(160) [not null, unique]
}

Table region_cities {
  city_code varchar(16) [pk]
  province_code varchar(16) [not null]
  name varchar(160) [not null]

  Indexes {
    (province_code)
    (province_code, name) [unique]
  }
}

Table region_wards {
  ward_code varchar(16) [pk]
  province_code varchar(16) [not null]
  city_code varchar(16) [not null]
  name varchar(160) [not null]

  Indexes {
    (city_code)
    (province_code, city_code, name)
  }
}

// =============================================================================
// CAFE PAGE
// =============================================================================

Table cafe_pages {
  id uuid [pk]
  owner_user_id uuid [not null]
  region_id uuid
  name varchar(160) [not null]
  address text [not null]
  description text
  avatar_url text
  cover_url text
  status page_status [not null, default: "DRAFT"]
  like_count int [not null, default: 0]
  follower_count int [not null, default: 0]
  max_members int [not null, default: 2]
  page_active boolean [not null, default: false]
  page_expires_at datetime
  created_at datetime [not null]
  updated_at datetime

  Note: "owner_user_id is the creator. Additional owners/staff live in page_members. Only ACTIVE + page_active=true pages can post blogs and receive orders."
}

Table page_members {
  page_id uuid [not null]
  user_id uuid [not null]
  role_name varchar(40) [not null, default: "MEMBER"]
  status page_member_status [not null, default: "ACTIVE"]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (page_id, user_id) [pk]
  }

  Note: "role_name uses constants OWNER / CO_OWNER / MEMBER. Self-registration creates MEMBER/PENDING; managers approve to ACTIVE/REJECTED. OWNER or CO_OWNER with status=ACTIVE can create blogs for the page."
}

Table page_follows {
  id uuid [pk]
  user_id uuid [not null]
  page_id uuid [not null]
  created_at datetime [not null]

  Indexes {
    (user_id, page_id) [unique]
    (user_id, created_at)
    (page_id, created_at)
  }
}

Table page_likes {
  id uuid [pk]
  user_id uuid [not null]
  page_id uuid [not null]
  created_at datetime [not null]

  Indexes {
    (user_id, page_id) [unique]
    (page_id)
  }
}

Table cafe_page_ratings {
  id uuid [pk]
  user_id uuid [not null]
  cafe_page_id uuid [not null]
  rating int [not null]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (user_id, cafe_page_id) [unique]
    (cafe_page_id)
    (rating)
  }

  Note: "rating between 1 and 5."
}

// =============================================================================
// BLOG (POSTS)
// =============================================================================

Table blogs {
  id uuid [pk]
  author_user_id uuid [not null]
  page_id uuid
  region_id uuid
  content text [not null]
  status post_status [not null, default: "PUBLISHED"]
  is_pinned boolean [not null, default: false]
  allow_comment boolean [not null, default: true]
  like_count int [not null, default: 0]
  share_count int [not null, default: 0]
  comment_count int [not null, default: 0]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (author_user_id, created_at)
    (status, created_at)
    (page_id, status, created_at)
    (region_id)
  }

  Note: "author_user_id is always the real user. page_id set => the blog is authored on behalf of that cafe page (writer must be an ACTIVE OWNER/CO_OWNER). region_id is a raw UUID column (no FK annotation) referencing regions.region_id."
}

Table blog_images {
  blog_id uuid [not null]
  image_url text

  Indexes {
    (blog_id)
  }

  Note: "ElementCollection side table. No surrogate PK; ordered as inserted."
}

Table blog_tagged_users {
  id uuid [pk]
  blog_id uuid [not null]
  tagged_user_id uuid [not null]
  tagged_by_user_id uuid [not null]
  created_at datetime [not null]

  Indexes {
    (blog_id, tagged_user_id) [unique]
    (blog_id)
    (tagged_user_id, created_at)
  }
}

Table comments {
  id uuid [pk]
  blog_id uuid [not null]
  user_id uuid [not null]
  actor_cafe_page_id uuid
  actor_context_type actor_context_type [not null, default: "USER"]
  parent_comment_id uuid
  content text [not null]
  status post_status [not null, default: "PUBLISHED"]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (blog_id, status, created_at)
    (parent_comment_id, status, created_at)
    (user_id, created_at)
    (actor_cafe_page_id, created_at)
  }

  Note: "parent_comment_id supports one-level replies. actor_context_type=CAFE_PAGE means the user commented on behalf of actor_cafe_page_id."
}

Table comment_images {
  comment_id uuid [not null]
  image_url text

  Indexes {
    (comment_id)
  }

  Note: "ElementCollection side table."
}

Table blog_likes {
  id uuid [pk]
  user_id uuid [not null]
  blog_id uuid [not null]
  actor_cafe_page_id uuid
  actor_context_type actor_context_type [not null, default: "USER"]
  created_at datetime [not null]

  Indexes {
    (user_id, created_at)
    (blog_id, created_at)
    (actor_cafe_page_id, created_at)
  }

  Note: "No global unique on (user_id, blog_id): the same user can like once as USER and once per CAFE_PAGE they represent. Uniqueness is enforced at service layer per (user_id, blog_id, actor_context_type, actor_cafe_page_id)."
}

Table blog_shares {
  id uuid [pk]
  blog_id uuid [not null]
  user_id uuid [not null]
  actor_cafe_page_id uuid
  actor_context_type actor_context_type [not null, default: "USER"]
  share_type share_type [not null, default: "PUBLIC"]
  created_at datetime [not null]

  Indexes {
    (blog_id, created_at)
    (user_id, created_at)
    (actor_cafe_page_id, created_at)
  }
}

Table blog_saves {
  id uuid [pk]
  user_id uuid [not null]
  blog_id uuid [not null]
  created_at datetime [not null]

  Indexes {
    (user_id, blog_id) [unique]
    (user_id, created_at)
    (blog_id, created_at)
  }
}

Table blog_ratings {
  id uuid [pk]
  user_id uuid [not null]
  blog_id uuid [not null]
  rating int [not null]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (user_id, blog_id) [unique]
    (blog_id)
    (rating)
  }

  Note: "rating between 1 and 5."
}

Table blog_events {
  id uuid [pk]
  blog_id uuid [not null]
  user_id uuid
  event_type blog_event_type [not null]
  weight double [not null, default: 1.0]
  created_at datetime [not null]

  Indexes {
    (blog_id, event_type, created_at)
    (created_at)
    (user_id, created_at)
  }
}

Table blog_daily_metrics {
  id uuid [pk]
  blog_id uuid [not null]
  metric_date date [not null]
  views bigint [not null, default: 0]
  likes bigint [not null, default: 0]
  comments bigint [not null, default: 0]
  shares bigint [not null, default: 0]
  saves bigint [not null, default: 0]
  reports bigint [not null, default: 0]
  avg_read_seconds double [not null, default: 0.0]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (blog_id, metric_date) [unique]
  }
}

Table blog_trending_scores {
  id uuid [pk]
  blog_id uuid [not null]
  window_type trend_window_type [not null]
  trend_score double [not null]
  rank_position int [not null]
  reason text
  computed_at datetime [not null]

  Indexes {
    (window_type, computed_at, rank_position)
    (blog_id)
  }
}

Table blog_ranking_overrides {
  id uuid [pk]
  blog_id uuid [not null]
  boost_score double [not null, default: 0.0]
  is_pinned boolean [not null, default: false]
  reason text
  start_at datetime [not null]
  end_at datetime
  created_by uuid
  created_at datetime [not null]

  Indexes {
    (blog_id)
    (start_at, end_at)
  }
}

Table blog_recommendation_scores {
  id uuid [pk]
  user_id uuid [not null]
  blog_id uuid [not null]
  window_type trend_window_type [not null]
  context_region_id uuid
  formula_version varchar(32) [not null, default: "LEGACY_V1"]
  feed_score double [not null]
  relationship_score double [not null, default: 0.0]
  interest_score double [not null, default: 0.0]
  engagement_score double [not null, default: 0.0]
  quality_score double [not null, default: 0.0]
  location_score double [not null, default: 0.0]
  diversity_score double [not null, default: 0.0]
  unseen_score double [not null, default: 0.0]
  trending_score double [not null, default: 0.0]
  followed_page_score double [not null, default: 0.0]
  followed_user_score double [not null, default: 0.0]
  same_region_score double [not null, default: 0.0]
  freshness_score double [not null, default: 0.0]
  activity_score double [not null, default: 0.0]
  own_author_score double [not null, default: 0.0]
  reviewer_score double [not null, default: 0.0]
  report_penalty double [not null, default: 0.0]
  seen_penalty double [not null, default: 0.0]
  repetition_penalty double [not null, default: 0.0]
  rank_position int [not null]
  reason text
  computed_at datetime [not null]
  created_at datetime [not null]

  Indexes {
    (user_id, blog_id, window_type, context_region_id) [unique]
    (user_id, window_type, context_region_id, computed_at, rank_position)
    (blog_id)
  }

  Note: "Personalized feed cache per user/window/region. API reads this table; scheduled or manual rebuild writes it. Component columns explain why a blog is recommended."
}

// =============================================================================
// FEED IMPRESSIONS
// =============================================================================

Table feed_impressions {
  id uuid [pk]
  user_id uuid [not null]
  blog_id uuid [not null]
  position int
  shown_at datetime [not null]
  clicked boolean [not null, default: false]
  dismissed boolean [not null, default: false]

  Indexes {
    (user_id, blog_id, shown_at)
    (user_id, shown_at)
  }

  Note: "Records blogs shown in a user's feed. Used to drive seen_penalty / diversity_score in blog_recommendation_scores."
}

// =============================================================================
// CHAT
// =============================================================================

Table conversations {
  id uuid [pk]
  type conversation_type [not null]
  group_name varchar(255)
  group_avatar varchar(255)
  cafe_page_id uuid
  latest_message_id uuid
  latest_message_preview text
  created_at datetime [not null]
  updated_at datetime [not null]

  Indexes {
    (type, cafe_page_id)
    (updated_at)
  }

  Note: "type=CAFE_PAGE conversations carry cafe_page_id. latest_message_id is a raw UUID reference to chat_messages.id (no JPA FK)."
}

Table chat_members {
  id uuid [pk]
  conversation_id uuid [not null]
  user_id uuid [not null]
  role member_role [not null, default: "MEMBER"]
  joined_at datetime [not null]

  Indexes {
    (conversation_id, user_id) [unique]
  }
}

Table chat_messages {
  id uuid [pk]
  conversation_id uuid [not null]
  sender_id uuid [not null]
  sender_cafe_page_id uuid
  sender_context_type chat_sender_context_type [not null, default: "USER"]
  type message_type [not null]
  text text
  sticker_url varchar(255)
  sticker_id varchar(255)
  status message_status [not null, default: "SENT"]
  is_read boolean [not null, default: false]
  read_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table chat_message_images {
  message_id uuid [not null]
  image_url text

  Indexes {
    (message_id)
  }

  Note: "ElementCollection side table."
}

// =============================================================================
// NOTIFICATION
// =============================================================================

Table notifications {
  id uuid [pk]
  recipient_id uuid [not null]
  actor_id uuid [not null]
  actor_cafe_page_id uuid
  actor_context_type actor_context_type [not null, default: "USER"]
  type notification_type [not null]
  target_type follow_target_type
  blog_id uuid
  conversation_id uuid
  target_user_id uuid
  target_cafe_page_id uuid
  comment_id uuid
  message_id uuid
  moderation_status varchar(64)
  moderation_reason varchar(1024)
  is_read boolean [not null, default: false]
  created_at datetime [not null]
  updated_at datetime [not null]

  Note: "target_type reuses the follow_target_type enum for USER/CAFE_PAGE. Target FK columns (blog_id, comment_id, message_id, etc.) are raw UUIDs — no JPA foreign key. Filled based on notification_type."
}

// =============================================================================
// REPORT & MODERATION
// =============================================================================

Table report_reasons {
  id uuid [pk]
  code varchar(80) [not null, unique]
  label_vi varchar(160) [not null]
  description_vi text
  target_type report_target_type
  severity int [not null, default: 1]
  requires_description boolean [not null, default: false]
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
  created_at datetime [not null]
  updated_at datetime

  Note: "Catalog of selectable report reasons. target_type null means the reason works for any target. Active reasons returned sorted by severity desc then sort_order asc."
}

Table content_reports {
  id uuid [pk]
  reporter_user_id uuid [not null]
  target_type report_target_type [not null]
  blog_id uuid
  comment_id uuid
  reported_user_id uuid
  cafe_page_id uuid
  reason_id uuid [not null]
  reason varchar(160) [not null]
  description text
  status report_status [not null, default: "OPEN"]
  created_at datetime [not null]
  resolved_at datetime

  Note: "target_type must match exactly one populated FK column: blog_id, comment_id, reported_user_id, or cafe_page_id. `reason` stores the label_vi snapshot at submission time."
}

Table report_moderation_jobs {
  id uuid [pk]
  content_report_id uuid [not null, unique]
  target_type report_target_type [not null]
  target_id uuid [not null]
  status report_moderation_job_status [not null, default: "PENDING"]
  attempt_count int [not null, default: 0]
  max_attempts int [not null, default: 3]
  next_attempt_at datetime [not null]
  processing_started_at datetime
  last_error text
  last_duration_ms bigint
  priority_score double [not null, default: 0.0]
  risk_score double [not null, default: 0.0]
  reason_severity_signal double [not null, default: 0.0]
  report_count_signal double [not null, default: 0.0]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (status, next_attempt_at)
    (content_report_id)
  }

  Note: "DB-backed queue for AI moderation triggered by reports. Worker claims due PENDING/FAILED rows with FOR UPDATE SKIP LOCKED and moves exhausted failures to DEAD_LETTER."
}

Table ai_moderation_results {
  id uuid [pk]
  blog_id uuid
  comment_id uuid
  content_report_id uuid
  caption text
  score double [not null]
  decision moderation_decision [not null]
  labels text
  explanation text
  caption_score int
  caption_reason text
  image_score int
  image_reason text
  tags jsonb
  ai_status varchar(50)
  raw_response jsonb
  model_name varchar(120)
  priority_score double
  risk_score double
  reason_severity_signal double
  report_count_signal double
  resolved boolean [not null, default: false]
  resolved_action moderation_resolve_action
  resolved_at datetime
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (blog_id, decision)
    (comment_id, decision)
  }
}

Table admin_report_ai_resolutions {
  id uuid [pk]
  content_report_id uuid [not null]
  target_type report_target_type [not null]
  target_id uuid [not null]
  report_decision admin_report_ai_report_decision [not null]
  target_action admin_report_ai_target_action [not null]
  confidence_score double
  risk_score double
  labels jsonb
  rule_code varchar(120)
  explanation text
  model_name varchar(120)
  raw_response jsonb
  created_at datetime [not null]

  Indexes {
    (content_report_id, created_at)
  }

  Note: "Admin-triggered synchronous AI recommendations for resolving a report. Advisory only; does not mutate content_reports or target content."
}

Table admin_report_ai_auto_apply_jobs {
  id uuid [pk]
  content_report_id uuid [not null]
  ai_resolution_id uuid [not null]
  target_type report_target_type [not null]
  target_id uuid [not null]
  report_decision admin_report_ai_report_decision [not null]
  target_action admin_report_ai_target_action [not null]
  confidence_score double
  risk_score double
  status admin_report_ai_auto_apply_job_status [not null, default: "SCHEDULED"]
  scheduled_at datetime [not null]
  applied_at datetime
  cancelled_at datetime
  created_by_admin_user_id uuid
  cancelled_by_admin_user_id uuid
  cancellation_reason varchar(160)
  last_error text
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (content_report_id, created_at)
    (status, scheduled_at)
  }

  Note: "Scheduled auto-apply of an AI resolution recommendation. Admin can cancel before scheduled_at is reached."
}

// =============================================================================
// ADMIN ASSISTANT (Internal AI chat for admins)
// =============================================================================

Table admin_assistant_conversations {
  id uuid [pk]
  admin_user_id uuid [not null]
  title varchar(160)
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (admin_user_id, updated_at)
  }
}

Table admin_assistant_messages {
  id uuid [pk]
  conversation_id uuid [not null]
  role admin_assistant_message_role [not null]
  content text [not null]
  metadata jsonb
  created_at datetime [not null]

  Indexes {
    (conversation_id, created_at)
  }
}

Table admin_assistant_tool_calls {
  id uuid [pk]
  conversation_id uuid [not null]
  message_id uuid
  tool_name varchar(100) [not null]
  input_payload jsonb
  output_summary jsonb
  status admin_assistant_tool_call_status [not null]
  error_message text
  duration_ms bigint
  created_at datetime [not null]

  Indexes {
    (conversation_id, created_at)
    (tool_name, created_at)
  }
}

Table admin_assistant_draft_actions {
  id uuid [pk]
  conversation_id uuid [not null]
  message_id uuid
  admin_user_id uuid [not null]
  action_type admin_assistant_draft_action_type [not null]
  payload jsonb
  explanation text
  source_refs jsonb
  status admin_assistant_draft_action_status [not null, default: "PENDING"]
  expires_at datetime [not null]
  executed_at datetime
  executed_by_admin_user_id uuid
  execution_result jsonb
  error_message text
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (conversation_id, created_at)
    (status, expires_at)
  }

  Note: "Drafted admin actions proposed by the AI assistant. Admin must execute them explicitly before expires_at."
}

// =============================================================================
// ADS
// =============================================================================

Table ad_fees {
  ad_fee_id uuid [pk]
  fee_type ad_fee_type [not null, unique]
  price decimal(12, 2) [not null]
  currency varchar(10) [not null, default: "VND"]
  status boolean [not null, default: true]
  created_at datetime [not null]
  updated_at datetime

  Note: "MVP has only FEED_10000_IMPRESSIONS_OR_30_DAYS."
}

Table ad_campaigns {
  ad_campaign_id uuid [pk]
  cafe_page_id uuid [not null]
  payment_id uuid [unique]
  title varchar(160) [not null]
  description text
  image_url text
  target_url text
  status ad_status [not null, default: "DRAFT"]
  start_at datetime
  end_at datetime
  priority int [not null, default: 1]
  max_impressions int [not null, default: 10000]
  served_impressions int [not null, default: 0]
  max_duration_days int [not null, default: 30]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (status, start_at, end_at)
    (cafe_page_id)
    (status, served_impressions)
  }

  Note: "Feed ads only. ACTIVE campaigns expire when served_impressions >= max_impressions, now >= start_at + max_duration_days, or now > end_at."
}

Table ad_target_regions {
  ad_target_region_id uuid [pk]
  ad_campaign_id uuid [not null]
  province varchar(120)
  city varchar(120)
  area varchar(120)
  ward varchar(120)
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (ad_campaign_id)
  }

  Note: "If a campaign has no ad_target_regions rows, it is global."
}

Table ad_impressions {
  ad_impression_id uuid [pk]
  ad_campaign_id uuid [not null]
  user_id uuid
  shown_at datetime [not null]

  Indexes {
    (ad_campaign_id, shown_at)
    (user_id, ad_campaign_id, shown_at)
  }
}

Table ad_clicks {
  ad_click_id uuid [pk]
  ad_campaign_id uuid [not null]
  user_id uuid
  clicked_at datetime [not null]

  Indexes {
    (ad_campaign_id, clicked_at)
    (user_id, ad_campaign_id, clicked_at)
  }
}

Table ad_daily_stats {
  ad_daily_stat_id uuid [pk]
  ad_campaign_id uuid [not null]
  stat_date date [not null]
  impressions int [not null, default: 0]
  clicks int [not null, default: 0]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (ad_campaign_id, stat_date) [unique]
  }
}

// =============================================================================
// PAYMENT
// =============================================================================

Table payments {
  payment_id uuid [pk]
  buyer_id uuid [not null]
  extra_fee_id uuid
  ad_fee_id uuid
  cafe_page_id uuid
  payment_method payment_method [not null]
  amount decimal(12, 2) [not null]
  currency varchar(10) [not null, default: "VND"]
  payment_status payment_status [not null, default: "PENDING"]
  created_at datetime [not null]
  updated_at datetime
  paid_at datetime
  expired_at datetime

  Indexes {
    (buyer_id)
    (extra_fee_id)
    (ad_fee_id)
    (cafe_page_id)
    (payment_status)
  }

  Note: "Exactly one of extra_fee_id or ad_fee_id is set. cafe_page_id links an ad payment to the paying cafe page. Successful extra_fee payments activate reviewer or cafe page packages; ad_fee payments only buy the package (campaign is created separately)."
}

Table payment_details {
  payment_detail_id uuid [pk]
  payment_id uuid [not null, unique]
  provider_name varchar(80)
  provider_transaction_id varchar(255)
  provider_order_id varchar(255)
  provider_payment_url text
  provider_qr_code_url text
  transfer_content varchar(255)
  raw_response text
  failure_code varchar(80)
  failure_message text
  note text
  created_at datetime [not null]
  updated_at datetime
}

Table extra_fees {
  extra_fee_id uuid [pk]
  name varchar(255) [not null]
  description varchar(255)
  fee_type extra_fee_type [not null]
  price bigint [not null]
  duration_months int
  max_members int
  status boolean [not null, default: true]
  created_at datetime [not null]
  updated_at datetime

  Note: "Successful REVIEWER_REGISTRATION payments activate/extend reviewer status. Successful CAFE_PAGE_OPENING payments activate the buyer's cafe page package (creating a DRAFT cafe_page + OWNER page_members row only when missing)."
}

// =============================================================================
// REVIEWER
// =============================================================================

Table reviewers {
  reviewer_id uuid [pk]
  user_id uuid [not null, unique]
  reviewer_active boolean [not null, default: false]
  reviewer_expires_at datetime
  created_at datetime [not null]
  updated_at datetime
}

Table reviewer_stripe_accounts {
  id uuid [pk]
  reviewer_id uuid [not null, unique]
  stripe_account_id varchar(100) [not null, unique]
  onboarding_status varchar(20) [not null, default: "PENDING"]
  charges_enabled boolean [not null, default: false]
  payouts_enabled boolean [not null, default: false]
  created_at datetime [not null]
  updated_at datetime

  Note: "onboarding_status uses string constants PENDING / INCOMPLETE / COMPLETE (not a native enum). Populated via the Stripe Connect onboarding webhook."
}

Table reviewer_formula {
  id uuid [pk]
  like_weight int [not null, default: 1]
  comment_weight int [not null, default: 5]
  share_weight int [not null, default: 3]
  like_payout_amount bigint [not null, default: 100]
  comment_payout_amount bigint [not null, default: 500]
  share_payout_amount bigint [not null, default: 300]
  iron_multiplier decimal(5, 2) [not null, default: 1.00]
  bronze_multiplier decimal(5, 2) [not null, default: 1.20]
  silver_multiplier decimal(5, 2) [not null, default: 1.50]
  gold_multiplier decimal(5, 2) [not null, default: 2.00]
  diamond_multiplier decimal(5, 2) [not null, default: 3.00]
  active boolean [not null, default: false]
  description varchar(255)
  created_by uuid
  created_at datetime [not null]
  updated_at datetime

  Note: "Combined ranking + payout formula. Only one row can have active=true at any time."
}

Table reviewer_badge_threshold {
  id uuid [pk]
  badge reviewer_badge [not null]
  min_score bigint [not null]
  formula_id uuid [not null]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (formula_id, badge) [unique]
  }

  Note: "Minimum score required per badge under a given formula."
}

Table reviewer_badges {
  id uuid [pk]
  reviewer_id uuid [not null]
  badge_month varchar(255) [not null]
  score bigint [not null, default: 0]
  badge reviewer_badge [not null]
  like_count bigint [not null, default: 0]
  share_count bigint [not null, default: 0]
  comment_count bigint [not null, default: 0]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (reviewer_id, badge_month) [unique]
  }

  Note: "Monthly badge history per reviewer. badge_month format: 'yyyy-MM'."
}

Table reviewer_ranking_snapshot {
  id uuid [pk]
  reviewer_id uuid [not null]
  period varchar(20) [not null]
  period_type ranking_period_type [not null]
  rank_position int [not null]
  score bigint [not null, default: 0]
  like_count bigint [not null, default: 0]
  share_count bigint [not null, default: 0]
  comment_count bigint [not null, default: 0]
  badge reviewer_badge [not null]
  formula_id uuid [not null]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (reviewer_id, period, period_type) [unique]
  }

  Note: "Periodic snapshots per reviewer. period format: 'yyyy-MM-dd' (DAILY), 'yyyy-Www' (WEEKLY), 'yyyy-MM' (MONTHLY). Generated via POST /api/admin/reviewer-config/ranking/generate."
}

Table reviewer_income {
  id uuid [pk]
  reviewer_id uuid [not null]
  income_date date [not null]
  like_count bigint [not null, default: 0]
  comment_count bigint [not null, default: 0]
  share_count bigint [not null, default: 0]
  badge reviewer_badge [not null]
  badge_multiplier decimal(5, 2) [not null]
  base_amount bigint [not null, default: 0]
  final_amount bigint [not null, default: 0]
  formula_id uuid [not null]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (reviewer_id, income_date) [unique]
    (income_date)
    (reviewer_id)
  }

  Note: "Daily income per reviewer. base_amount = like*like_payout + comment*comment_payout + share*share_payout. final_amount = base_amount * badge_multiplier. Upsert on (reviewer_id, income_date). Auto-generated daily at 3AM for yesterday."
}

Table reviewer_payouts {
  id uuid [pk]
  reviewer_id uuid [not null]
  payout_month varchar(255) [not null]
  like_count bigint [not null, default: 0]
  share_count bigint [not null, default: 0]
  comment_count bigint [not null, default: 0]
  like_amount bigint [not null, default: 0]
  share_amount bigint [not null, default: 0]
  comment_amount bigint [not null, default: 0]
  total_amount bigint [not null, default: 0]
  payout_status payout_status [not null, default: "CALCULATED"]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (reviewer_id, payout_month) [unique]
  }

  Note: "Legacy monthly aggregation per reviewer. New payout flow uses admin_payout below."
}

Table admin_payout {
  id uuid [pk]
  reviewer_id uuid [not null]
  payout_month varchar(7) [not null]
  total_base_amount bigint [not null, default: 0]
  badge reviewer_badge [not null]
  badge_multiplier decimal(5, 2) [not null]
  total_final_amount bigint [not null, default: 0]
  status admin_payout_status [not null, default: "PENDING"]
  approved_by uuid
  approved_at datetime
  paid_at datetime
  note varchar(255)
  stripe_transfer_id varchar(100)
  stripe_idempotency_key varchar(200)
  formula_id uuid [not null]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (reviewer_id, payout_month) [unique]
    (payout_month)
    (status)
  }

  Note: "Monthly payout managed by admin. payout_month format: 'yyyy-MM'. Status flow: PENDING → APPROVED → PAID (or CANCELLED). status uses a Postgres NAMED_ENUM (only entity that does). total_base_amount = SUM(reviewer_income.base_amount) for the month; total_final_amount = total_base_amount * badge_multiplier. Auto-generated on the 1st of each month at 4AM. stripe_transfer_id / stripe_idempotency_key are set after a Stripe transfer succeeds."
}

