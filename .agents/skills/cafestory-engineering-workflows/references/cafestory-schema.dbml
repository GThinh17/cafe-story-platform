Ref: notifications.target_user_id > users.user_id
Ref: notifications.target_cafe_page_id > cafe_pages.id
Ref: notifications.comment_id > comments.id
Ref: notifications.message_id > chat_messages.id

Ref: content_reports.reporter_user_id > users.user_id
Ref: content_reports.blog_id > blogs.id
Ref: content_reports.comment_id > comments.id
Ref: content_reports.reported_user_id > users.user_id
Ref: content_reports.cafe_page_id > cafe_pages.id
Ref: content_reports.reason_id > report_reasons.id
Ref: report_moderation_jobs.content_report_id > content_reports.id
Ref: ai_moderation_results.blog_id > blogs.id
Ref: ai_moderation_results.comment_id > comments.id
Ref: ai_moderation_results.content_report_id > content_reports.id
Ref: admin_report_ai_resolutions.content_report_id > content_reports.id
