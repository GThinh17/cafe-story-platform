Project cafe_story_platform {
  database_type: "PostgreSQL"
  Note: "Recommended ERD rewrite from ERD_CT250H.drawio. Focus: clean likes, comments, follows, cafe pages, moderation, reviewer, and payment flows."
}

Enum user_status {
  ACTIVE
  INACTIVE
  BANNED
}

Enum page_status {
  DRAFT
  ACTIVE
  SUSPENDED
}

Enum post_status {
  DRAFT
  PUBLISHED
  HIDDEN
  REMOVED
}

Enum report_status {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

Enum report_target_type {
  BLOG
  COMMENT
  USER
  CAFE_PAGE
}

Enum moderation_decision {
  SAFE
  NEEDS_REVIEW
  VIOLATION
}

Enum payment_status {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
  REFUNDED
}

Enum payment_method {
  STRIPE_CARD
  BANK_TRANSFER
  VNPAY
}

Enum payout_status {
  PENDING
  APPROVED
  REJECTED
  PAID
}

Enum share_type {
  PUBLIC
  PRIVATE
  PAGE_ONLY
}

Enum conversation_type {
  DIRECT
  GROUP
}

Enum member_role {
  OWNER
  CO_OWNER
  ADMIN
  MEMBER
}

Enum page_member_status {
  PENDING
  ACTIVE
  REJECTED
}

Enum blog_event_type {
  VIEW
  LIKE
  COMMENT
  SHARE
  SAVE
  REPORT
}

Enum trend_window_type {
  HOUR_24
  DAY_7
  MONTH_1
}

Enum message_type {
  TEXT  
  IMAGE
  STICKER
  MIXED
}

Enum message_status {
  SENT
  FAILED
  DELETED
}

Enum notification_type {
  LIKE
  SHARE
  COMMENT
  MESSAGE
  FOLLOW
}

Enum reviewer_badge {
  IRON
  BRONZE
  SILVER
  GOLD
  DIAMOND
}

Enum reviewer_payout_status {
  CALCULATED
  PAID
  CANCELLED
}

Enum extra_fee_type {
  REVIEWER_REGISTRATION
  CAFE_PAGE_OPENING
}

Enum ad_status {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  REJECTED
}

Enum ad_fee_type {
  FEED_10000_IMPRESSIONS_OR_30_DAYS
}

Table users {
  user_id uuid [pk]
  user_name varchar(255) [not null]
  user_full_name varchar(255)
  user_password varchar(255) [not null]
  user_email varchar(255) [not null, unique]
  user_phone bigint
  user_avatar varchar(255)
  region_id uuid
  user_like int [not null, default: 0]
  user_follower int [not null, default: 0]
  account_status boolean [not null, default: true]
  Note: "Current backend schema. user_like and user_follower are cached counters updated by services; relation tables remain the source of truth."
}

Table roles {
  id int [pk]
  name varchar(60) [not null, unique]
  Note: "Default roles seeded by backend: USER, REVIEWER, ADMIN, CAFE_PAGE."
}

Table user_roles {
  user_id uuid [not null]
  role_id int [not null]
  created_at datetime [not null]

  Indexes {
    (user_id, role_id) [pk]
  }
}

Table refresh_tokens {
  id uuid [pk]
  user_id uuid [not null]
  token_hash varchar(64) [not null, unique]
  expires_at datetime [not null]
  revoked_at datetime
  created_at datetime [not null]

  Indexes {
    (user_id)
    (expires_at)
    (revoked_at)
  }

  Note: "Stores SHA-256 hashes of refresh tokens only. Raw refresh tokens are sent to clients in HttpOnly cookie refresh_token and are never persisted."
}

Table regions {
  region_id uuid [pk]
  city_code varchar(16)
  city varchar(255)
  province_code varchar(16)
  province varchar(255)
  ward_code varchar(16)
  ward varchar(255)
  area varchar(255)
  street varchar(255)
  created_at datetime [not null]
  updated_at datetime
  Note: "Shared location/address table. province_code/city_code/ward_code point to normalized Vietnam lookup tables while text fields keep display snapshots. Blog locations require province and city. User and cafe page addresses require province, city, ward, and street."
}

Table region_provinces {
  province_code varchar(16) [pk]
  name varchar(160) [not null, unique]
}

Table region_cities {
  city_code varchar(16) [pk]
  province_code varchar(16) [not null]
  name varchar(160) [not null]

  Indexes {
    (province_code)
    (province_code, name) [unique]
  }
}

Table region_wards {
  ward_code varchar(16) [pk]
  province_code varchar(16) [not null]
  city_code varchar(16) [not null]
  name varchar(160) [not null]

  Indexes {
    (province_code)
    (city_code)
    (province_code, name)
  }
}

Table cafe_pages {
  id uuid [pk]
  owner_user_id uuid [not null, unique]
  region_id uuid
  name varchar(160) [not null]
  address text [not null]
  description text
  avatar_url text
  cover_url text
  status page_status [not null, default: "DRAFT"]
  like_count int [not null, default: 0]
  follower_count int [not null, default: 0]
  max_members int [not null, default: 2]
  page_active boolean [not null, default: false]
  page_expires_at datetime
  created_at datetime [not null]
  updated_at datetime
  Note: "owner_user_id is the creator/primary owner and must be unique so one user can create only one cafe page. Use page_members for additional owners/staff."
}

Table page_members {
  page_id uuid [not null]
  user_id uuid [not null]
  role_name varchar(40) [not null, default: "MEMBER"]
  status page_member_status [not null, default: "ACTIVE"]
  created_at datetime [not null]
  updated_at datetime
  Note: "Stores cafe page members and co-owners. User self-registration creates MEMBER/PENDING. Page managers can approve to ACTIVE/REJECTED or add members directly as ACTIVE. OWNER/CO_OWNER ACTIVE can create blogs for this page."

  Indexes {
    (page_id, user_id) [pk]
  }
}

Table blogs {
  id uuid [pk]
  author_user_id uuid [not null]
  page_id uuid
  region_id uuid
  content text [not null]
  status post_status [not null, default: "PUBLISHED"]
  is_pinned boolean [not null, default: false]
  allow_comment boolean [not null, default: true]
  like_count int [not null, default: 0]
  share_count int [not null, default: 0]
  comment_count int [not null, default: 0]
  created_at datetime [not null]
  updated_at datetime
  Note: "If page_id is set, the post belongs to a cafe page but still has a real user author."
}

Table blog_images {
  blog_id uuid [not null]
  image_url text
}

Table comments {
  id uuid [pk]
  blog_id uuid [not null]
  user_id uuid [not null]
  parent_comment_id uuid
  content text [not null]
  status post_status [not null, default: "PUBLISHED"]
  created_at datetime [not null]
  updated_at datetime
  Note: "This replaces Comment + detail_comment. parent_comment_id supports replies."
}

Table comment_images {
  comment_id uuid [not null]
  image_url text
}

Table blog_likes {
  id uuid [pk]
  user_id uuid [not null]
  blog_id uuid [not null]
  created_at datetime [not null]

  Indexes {
    (user_id, blog_id) [unique]
    (blog_id)
  }
}

Table comment_likes {
  user_id uuid [not null]
  comment_id uuid [not null]
  created_at datetime [not null]

  Indexes {
    (user_id, comment_id) [pk]
    (comment_id)
  }
}

Table page_likes {
  id uuid [pk]
  user_id uuid [not null]
  page_id uuid [not null]
  created_at datetime [not null]

  Indexes {
    (user_id, page_id) [unique]
    (page_id)
  }
}

Table user_follows {
  id uuid [pk]
  follower_user_id uuid [not null]
  following_user_id uuid [not null]
  created_at datetime [not null]

  Indexes {
    (follower_user_id, following_user_id) [unique]
    (following_user_id)
  }

  Note: "Add an application/database check: follower_user_id <> following_user_id."
}

Table page_follows {
  id uuid [pk]
  user_id uuid [not null]
  page_id uuid [not null]
  created_at datetime [not null]

  Indexes {
    (user_id, page_id) [unique]
    (page_id)
  }
}

Table blog_shares {
  id uuid [pk]
  blog_id uuid [not null]
  user_id uuid [not null]
  share_type share_type [not null, default: "PUBLIC"]
  created_at datetime [not null]

  Indexes {
    (blog_id)
    (user_id)
  }
}

Table blog_events {
  id uuid [pk]
  blog_id uuid [not null]
  user_id uuid
  event_type blog_event_type [not null]
  weight decimal(8, 2) [not null, default: 1.0]
  created_at datetime [not null]

  Indexes {
    (blog_id)
    (user_id)
    (event_type)
    (created_at)
  }
}

Table blog_daily_metrics {
  id uuid [pk]
  blog_id uuid [not null]
  metric_date date [not null]
  views bigint [not null, default: 0]
  likes bigint [not null, default: 0]
  comments bigint [not null, default: 0]
  shares bigint [not null, default: 0]
  saves bigint [not null, default: 0]
  reports bigint [not null, default: 0]
  avg_read_seconds decimal(10, 2) [not null, default: 0]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (blog_id, metric_date) [unique]
  }
}

Table blog_trending_scores {
  id uuid [pk]
  blog_id uuid [not null]
  window_type trend_window_type [not null]
  trend_score decimal(14, 4) [not null]
  rank_position int [not null]
  reason text
  computed_at datetime [not null]

  Indexes {
    (window_type, computed_at)
    (rank_position)
  }
}

Table blog_ranking_overrides {
  id uuid [pk]
  blog_id uuid [not null]
  boost_score decimal(12, 2) [not null, default: 0]
  is_pinned boolean [not null, default: false]
  reason text
  start_at datetime [not null]
  end_at datetime
  created_by uuid
  created_at datetime [not null]

  Indexes {
    (blog_id)
    (start_at, end_at)
  }
}

Table blog_recommendation_scores {
  id uuid [pk]
  user_id uuid [not null]
  blog_id uuid [not null]
  window_type trend_window_type [not null]
  context_region_id uuid
  feed_score decimal(14, 4) [not null]
  trending_score decimal(14, 4) [not null, default: 0]
  followed_page_score decimal(14, 4) [not null, default: 0]
  followed_user_score decimal(14, 4) [not null, default: 0]
  same_region_score decimal(14, 4) [not null, default: 0]
  freshness_score decimal(14, 4) [not null, default: 0]
  report_penalty decimal(14, 4) [not null, default: 0]
  rank_position int [not null]
  reason text
  computed_at datetime [not null]
  created_at datetime [not null]

  Indexes {
    (user_id, blog_id, window_type, context_region_id) [unique]
    (user_id, window_type, context_region_id, computed_at)
    (user_id, window_type, context_region_id, rank_position)
    (blog_id)
  }

  Note: "Cached personalized feed scores per user/window/region context. API reads this table; scheduled/manual rebuild writes it. Component columns explain why a blog is recommended."
}

Table conversations {
  id uuid [pk]
  type conversation_type [not null]
  group_name varchar(255)
  group_avatar varchar(255)
  latest_message_id uuid
  latest_message_preview text
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table chat_members {
  id uuid [pk]
  conversation_id uuid [not null]
  user_id uuid [not null]
  role member_role [not null, default: "MEMBER"]
  joined_at datetime [not null]

  Indexes {
    (conversation_id, user_id) [unique]
  }
}

Table chat_messages {
  id uuid [pk]
  conversation_id uuid [not null]
  sender_id uuid [not null]
  type message_type [not null]
  text text
  sticker_url varchar(255)
  sticker_id varchar(255)
  status message_status [not null, default: "SENT"]
  is_read boolean [not null, default: false]
  read_at datetime
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table chat_message_images {
  message_id uuid [not null]
  image_url text
}

Table notifications {
  id uuid [pk]
  recipient_id uuid [not null]
  actor_id uuid [not null]
  type notification_type [not null]
  blog_id uuid
  conversation_id uuid
  target_user_id uuid
  comment_id uuid
  message_id uuid
  is_read boolean [not null, default: false]
  created_at datetime [not null]
  updated_at datetime [not null]
}

Table ai_moderation_results {
  id uuid [pk]
  blog_id uuid
  comment_id uuid
  score decimal(5, 4) [not null]
  decision moderation_decision [not null]
  labels text
  explanation text
  model_name varchar(120)
  created_at datetime [not null]
}

Table reviewers {
  reviewer_id uuid [pk]
  user_id uuid [not null, unique]
  reviewer_active boolean [not null, default: false]
  reviewer_expires_at datetime
  created_at datetime [not null]
  updated_at datetime
}

Table reviewer_badges {
  id uuid [pk]
  reviewer_id uuid [not null]
  badge_month varchar(255) [not null]
  score bigint [not null, default: 0]
  badge reviewer_badge [not null]
  like_count bigint [not null, default: 0]
  share_count bigint [not null, default: 0]
  comment_count bigint [not null, default: 0]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (reviewer_id, badge_month) [unique]
  }
}

Table reviewer_payouts {
  id uuid [pk]
  reviewer_id uuid [not null]
  payout_month varchar(255) [not null]
  like_count bigint [not null, default: 0]
  share_count bigint [not null, default: 0]
  comment_count bigint [not null, default: 0]
  like_amount bigint [not null, default: 0]
  share_amount bigint [not null, default: 0]
  comment_amount bigint [not null, default: 0]
  total_amount bigint [not null, default: 0]
  payout_status reviewer_payout_status [not null, default: "CALCULATED"]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (reviewer_id, payout_month) [unique]
  }
}

Table payment_methods {
  id int [pk]
  name varchar(80) [not null, unique]
  status boolean [not null, default: true]
  created_at datetime [not null]
}

Table payments {
  payment_id uuid [pk]
  buyer_id uuid [not null]
  extra_fee_id uuid
  ad_fee_id uuid
  payment_method payment_method [not null]
  amount decimal(12, 2) [not null]
  currency varchar(10) [not null, default: "VND"]
  payment_status payment_status [not null, default: "PENDING"]
  created_at datetime [not null]
  updated_at datetime
  paid_at datetime
  expired_at datetime

  Indexes {
    (buyer_id)
    (extra_fee_id)
    (ad_fee_id)
    (payment_status)
  }

  Note: "Exactly one of extra_fee_id or ad_fee_id must be set. Extra fee payments activate existing products after PAID; ad fee payments only buy the package and campaigns are created separately."
}

Table payment_details {
  payment_detail_id uuid [pk]
  payment_id uuid [not null, unique]
  provider_name varchar(80)
  provider_transaction_id varchar(255)
  provider_order_id varchar(255)
  provider_payment_url text
  provider_qr_code_url text
  transfer_content varchar(255)
  raw_response text
  failure_code varchar(80)
  failure_message text
  note text
  created_at datetime [not null]
  updated_at datetime
}

Table extra_fees {
  Note: "Successful REVIEWER_REGISTRATION payments activate/extend reviewer status. Successful CAFE_PAGE_OPENING payments activate the buyer's cafe page package, creating a draft cafe page and OWNER page_members row only when missing; payment request does not carry cafe page name/address."
  extra_fee_id uuid [pk]
  name varchar(255) [not null]
  description text
  fee_type extra_fee_type [not null]
  price bigint [not null]
  duration_months int
  max_members int
  status boolean [not null, default: true]
  created_at datetime [not null]
  updated_at datetime
}

Table ad_fees {
  ad_fee_id uuid [pk]
  fee_type ad_fee_type [not null, unique]
  price decimal(12, 2) [not null]
  currency varchar(10) [not null, default: "VND"]
  status boolean [not null, default: true]
  created_at datetime [not null]
  updated_at datetime

  Note: "price must be greater than 0. MVP supports only FEED_10000_IMPRESSIONS_OR_30_DAYS."
}

Table ad_campaigns {
  ad_campaign_id uuid [pk]
  cafe_page_id uuid [not null]
  payment_id uuid [unique]
  title varchar(160) [not null]
  description text
  image_url text
  target_url text
  status ad_status [not null, default: "DRAFT"]
  start_at datetime
  end_at datetime
  priority int [not null, default: 1]
  max_impressions int [not null, default: 10000]
  served_impressions int [not null, default: 0]
  max_duration_days int [not null, default: 30]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (status, start_at, end_at)
    (cafe_page_id)
    (payment_id)
    (status, served_impressions)
  }

  Note: "Feed ads only; no placement column. max_impressions must equal 10000, max_duration_days must equal 30, served_impressions must be between 0 and max_impressions. ACTIVE campaigns expire when served_impressions >= 10000, now >= start_at + 30 days, or now > end_at."
}

Table ad_target_regions {
  ad_target_region_id uuid [pk]
  ad_campaign_id uuid [not null]
  province varchar(120)
  city varchar(120)
  area varchar(120)
  ward varchar(120)
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (ad_campaign_id)
    (province)
    (city)
    (area)
    (ward)
  }

  Note: "If a campaign has no target region rows, it is global."
}

Table ad_impressions {
  ad_impression_id uuid [pk]
  ad_campaign_id uuid [not null]
  user_id uuid
  shown_at datetime [not null]

  Indexes {
    (ad_campaign_id, shown_at)
    (user_id, ad_campaign_id, shown_at)
  }
}

Table ad_clicks {
  ad_click_id uuid [pk]
  ad_campaign_id uuid [not null]
  user_id uuid
  clicked_at datetime [not null]

  Indexes {
    (ad_campaign_id, clicked_at)
    (user_id, ad_campaign_id, clicked_at)
  }
}

Table ad_daily_stats {
  ad_daily_stat_id uuid [pk]
  ad_campaign_id uuid [not null]
  stat_date date [not null]
  impressions int [not null, default: 0]
  clicks int [not null, default: 0]
  created_at datetime [not null]
  updated_at datetime

  Indexes {
    (ad_campaign_id, stat_date) [unique]
  }
}

Table payouts {
  id uuid [pk]
  reviewer_id uuid [not null]
  payment_method_id int [not null]
  amount decimal(12, 2) [not null]
  status payout_status [not null, default: "PENDING"]
  created_at datetime [not null]
  paid_at datetime
}

Table report_reasons {
  id uuid [pk]
  code varchar(80) [not null, unique]
  label_vi varchar(160) [not null]
  description_vi text
  target_type report_target_type
  severity int [not null, default: 1]
  requires_description boolean [not null, default: false]
  is_active boolean [not null, default: true]
  sort_order int [not null, default: 0]
  created_at datetime [not null]
  updated_at datetime

  Note: "Catalog of selectable report reasons. target_type null means the reason can be used for any target type. Active reasons are returned sorted by severity desc, sort_order asc."
}

Table content_reports {
  id uuid [pk]
  reporter_user_id uuid [not null]
  target_type report_target_type [not null]
  blog_id uuid
  comment_id uuid
  reported_user_id uuid
  cafe_page_id uuid
  reason_id uuid [not null]
  reason varchar(160) [not null]
  description text
  status report_status [not null, default: "OPEN"]
  created_at datetime [not null]
  resolved_at datetime

  Note: "Use target_type with exactly one matching target FK: blog_id, comment_id, reported_user_id, or cafe_page_id. reason stores the label snapshot selected from report_reasons."
}

Ref: user_roles.user_id > users.user_id
Ref: user_roles.role_id > roles.id
Ref: refresh_tokens.user_id > users.user_id

Ref: cafe_pages.owner_user_id > users.user_id
Ref: users.region_id > regions.region_id
Ref: cafe_pages.region_id > regions.region_id
Ref: regions.province_code > region_provinces.province_code
Ref: regions.city_code > region_cities.city_code
Ref: regions.ward_code > region_wards.ward_code
Ref: region_cities.province_code > region_provinces.province_code
Ref: region_wards.province_code > region_provinces.province_code
Ref: region_wards.city_code > region_cities.city_code
Ref: page_members.page_id > cafe_pages.id
Ref: page_members.user_id > users.user_id

Ref: blogs.author_user_id > users.user_id
Ref: blogs.page_id > cafe_pages.id
Ref: blog_images.blog_id > blogs.id
Ref: comments.blog_id > blogs.id
Ref: comments.user_id > users.user_id
Ref: comments.parent_comment_id > comments.id
Ref: comment_images.comment_id > comments.id

Ref: blog_likes.user_id > users.user_id
Ref: blog_likes.blog_id > blogs.id
Ref: comment_likes.user_id > users.user_id
Ref: comment_likes.comment_id > comments.id
Ref: page_likes.user_id > users.user_id
Ref: page_likes.page_id > cafe_pages.id

Ref: user_follows.follower_user_id > users.user_id
Ref: user_follows.following_user_id > users.user_id
Ref: page_follows.user_id > users.user_id
Ref: page_follows.page_id > cafe_pages.id

Ref: blog_shares.blog_id > blogs.id
Ref: blog_shares.user_id > users.user_id
Ref: blog_events.blog_id > blogs.id
Ref: blog_events.user_id > users.user_id
Ref: blog_daily_metrics.blog_id > blogs.id
Ref: blog_trending_scores.blog_id > blogs.id
Ref: blog_ranking_overrides.blog_id > blogs.id
Ref: blog_ranking_overrides.created_by > users.user_id
Ref: blog_recommendation_scores.user_id > users.user_id
Ref: blog_recommendation_scores.blog_id > blogs.id
Ref: blog_recommendation_scores.context_region_id > regions.region_id

Ref: chat_members.conversation_id > conversations.id
Ref: chat_members.user_id > users.user_id
Ref: chat_messages.conversation_id > conversations.id
Ref: chat_messages.sender_id > users.user_id
Ref: chat_message_images.message_id > chat_messages.id

Ref: notifications.recipient_id > users.user_id
Ref: notifications.actor_id > users.user_id

Ref: reviewers.user_id > users.user_id
Ref: reviewer_badges.reviewer_id > reviewers.reviewer_id
Ref: reviewer_payouts.reviewer_id > reviewers.reviewer_id

Ref: payments.buyer_id > users.user_id
Ref: payments.extra_fee_id > extra_fees.extra_fee_id
Ref: payments.ad_fee_id > ad_fees.ad_fee_id
Ref: payment_details.payment_id > payments.payment_id
Ref: ad_campaigns.cafe_page_id > cafe_pages.id
Ref: ad_campaigns.payment_id > payments.payment_id
Ref: ad_target_regions.ad_campaign_id > ad_campaigns.ad_campaign_id
