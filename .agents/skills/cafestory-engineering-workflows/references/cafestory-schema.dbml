Ref: ad_campaigns.cafe_page_id > cafe_pages.id
Ref: ad_campaigns.payment_id > payments.payment_id
Ref: ad_target_regions.ad_campaign_id > ad_campaigns.ad_campaign_id
Ref: ad_impressions.ad_campaign_id > ad_campaigns.ad_campaign_id
Ref: ad_impressions.user_id > users.user_id
Ref: ad_clicks.ad_campaign_id > ad_campaigns.ad_campaign_id
Ref: ad_clicks.user_id > users.user_id
Ref: ad_daily_stats.ad_campaign_id > ad_campaigns.ad_campaign_id

Ref: reviewers.user_id > users.user_id
Ref: reviewer_stripe_accounts.reviewer_id > reviewers.reviewer_id
Ref: reviewer_formula.created_by > users.user_id
Ref: reviewer_badge_threshold.formula_id > reviewer_formula.id
Ref: reviewer_badges.reviewer_id > reviewers.reviewer_id
Ref: reviewer_ranking_snapshot.reviewer_id > reviewers.reviewer_id
Ref: reviewer_ranking_snapshot.formula_id > reviewer_formula.id
Ref: reviewer_income.reviewer_id > reviewers.reviewer_id
Ref: reviewer_income.formula_id > reviewer_formula.id
Ref: reviewer_payouts.reviewer_id > reviewers.reviewer_id
Ref: admin_payout.reviewer_id > reviewers.reviewer_id
Ref: admin_payout.approved_by > users.user_id
Ref: admin_payout.formula_id > reviewer_formula.id
