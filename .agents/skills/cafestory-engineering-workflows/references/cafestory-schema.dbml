Ref: admin_report_ai_auto_apply_jobs.ai_resolution_id > admin_report_ai_resolutions.id
Ref: admin_report_ai_auto_apply_jobs.created_by_admin_user_id > users.user_id
Ref: admin_report_ai_auto_apply_jobs.cancelled_by_admin_user_id > users.user_id

Ref: admin_assistant_conversations.admin_user_id > users.user_id
Ref: admin_assistant_messages.conversation_id > admin_assistant_conversations.id
Ref: admin_assistant_tool_calls.conversation_id > admin_assistant_conversations.id
Ref: admin_assistant_tool_calls.message_id > admin_assistant_messages.id
Ref: admin_assistant_draft_actions.conversation_id > admin_assistant_conversations.id
Ref: admin_assistant_draft_actions.message_id > admin_assistant_messages.id
Ref: admin_assistant_draft_actions.admin_user_id > users.user_id
Ref: admin_assistant_draft_actions.executed_by_admin_user_id > users.user_id

Ref: payments.buyer_id > users.user_id
Ref: payments.extra_fee_id > extra_fees.extra_fee_id
Ref: payments.ad_fee_id > ad_fees.ad_fee_id
Ref: payments.cafe_page_id > cafe_pages.id
