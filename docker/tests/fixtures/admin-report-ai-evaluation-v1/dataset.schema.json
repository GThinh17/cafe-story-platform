{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cafestory.local/contracts/admin-report-ai-evaluation-dataset-v1.schema.json",
  "title": "CafeStory Admin Report AI Evaluation Dataset V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "datasetVersion",
    "lifecycle",
    "runtimeAuthority",
    "description",
    "versions",
    "evidenceBundles",
    "records"
  ],
  "properties": {
    "datasetVersion": { "const": "1.0.0-rc.1" },
    "lifecycle": { "enum": ["PROPOSED", "APPROVED", "RETIRED"] },
    "runtimeAuthority": { "const": false },
    "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "versions": { "$ref": "#/$defs/versions" },
    "evidenceBundles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/evidenceBundle" }
    },
    "records": {
      "type": "array",
      "minItems": 20,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "codeList": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/code" }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contractVersion",
        "contextSchemaVersion",
        "evidenceEnvelopeVersion",
        "policyVersion",
        "ruleCatalogVersion",
        "ruleVersion",
        "promptVersion",
        "runtimeRequestSchemaId",
        "providerOutputSchemaId",
        "rubricVersion"
      ],
      "properties": {
        "contractVersion": { "const": "2.0" },
        "contextSchemaVersion": { "const": "RRC-1.0.0-rc.1" },
        "evidenceEnvelopeVersion": { "const": "1.0.0-rc.1" },
        "policyVersion": { "const": "PF-2.0.0-proposed.1" },
        "ruleCatalogVersion": { "const": "RC-2.0.0-proposed.2" },
        "ruleVersion": { "const": "1.0.0-proposed.2" },
        "promptVersion": { "const": "report-ai-v2-sprint2.2" },
        "runtimeRequestSchemaId": {
          "const": "https://cafestory.local/contracts/admin-report-ai-runtime-request-s2.schema.json"
        },
        "providerOutputSchemaId": {
          "const": "https://cafestory.local/contracts/admin-report-ai-provider-output-s2.schema.json"
        },
        "rubricVersion": { "const": "1.0.0-rc.1" }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "evidenceKind",
        "availability",
        "quality",
        "sourceType",
        "intendedUse",
        "payloadMode"
      ],
      "properties": {
        "evidenceId": { "$ref": "#/$defs/code" },
        "evidenceKind": { "$ref": "#/$defs/code" },
        "availability": {
          "enum": ["AVAILABLE", "MISSING", "NOT_COLLECTED", "STALE", "UNREADABLE"]
        },
        "quality": { "enum": ["HIGH", "MEDIUM", "LOW", "UNUSABLE"] },
        "sourceType": {
          "enum": [
            "PLATFORM_RECORD",
            "TARGET_SNAPSHOT",
            "VERIFIED_MEDIA_OBSERVATION",
            "AUTHORITATIVE_EXTERNAL_REFERENCE",
            "REPORTER_CLAIM",
            "DERIVED_SIGNAL"
          ]
        },
        "intendedUse": {
          "enum": [
            "RULE_EVALUATION_CANDIDATE",
            "COUNTER_EVIDENCE_CANDIDATE",
            "CONTEXT_ONLY"
          ]
        },
        "payloadMode": { "enum": ["INLINE_SANITIZED", "REFERENCE_ONLY", "NONE"] }
      }
    },
    "evidenceBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "targetTypes",
        "collectionState",
        "envelopeVersion",
        "snapshotBinding",
        "includesRequiredKinds",
        "items"
      ],
      "properties": {
        "bundleId": { "$ref": "#/$defs/code" },
        "targetTypes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["BLOG", "COMMENT"] }
        },
        "collectionState": {
          "enum": [
            "AVAILABLE_COMPLETE",
            "MISSING_REQUIRED_KIND",
            "CONFLICTING_MATERIAL",
            "UNASSESSABLE_SOURCE"
          ]
        },
        "envelopeVersion": { "const": "1.0.0-rc.1" },
        "snapshotBinding": { "enum": ["MATCHED", "STALE"] },
        "includesRequiredKinds": { "type": "boolean" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/evidenceItem" }
        }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshotVersion",
        "contentText",
        "materializedContentLength",
        "parentExcerpt",
        "imageReferences"
      ],
      "properties": {
        "snapshotVersion": { "type": "string", "pattern": "^[1-9][0-9]*$" },
        "contentText": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "materializedContentLength": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "parentExcerpt": {
          "type": ["string", "null"],
          "maxLength": 1000
        },
        "imageReferences": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "minLength": 1, "maxLength": 2048 }
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "contentLength",
        "contextType",
        "evidenceSufficiency",
        "attackVector",
        "policyMode"
      ],
      "properties": {
        "language": { "enum": ["VI", "EN", "MIXED", "NONE"] },
        "contentLength": { "enum": ["SHORT", "NORMAL", "LONG", "BOUNDARY_4000"] },
        "contextType": { "enum": ["DIRECT", "CONTEXT_DEPENDENT"] },
        "evidenceSufficiency": {
          "enum": ["SUFFICIENT", "INSUFFICIENT", "CONFLICTED", "UNASSESSABLE"]
        },
        "attackVector": {
          "enum": [
            "CLEAN",
            "UNKNOWN_RULE",
            "UNKNOWN_VERSION",
            "UNKNOWN_EVIDENCE",
            "STALE_SNAPSHOT",
            "TARGET_TEXT_INJECTION",
            "REPORT_CLAIM_INJECTION",
            "MEDIA_REFERENCE_INJECTION",
            "PRIOR_AI_INJECTION",
            "SCHEMA_BOUNDARY"
          ]
        },
        "policyMode": {
          "enum": [
            "PROPOSED_EVALUATION_ONLY",
            "INACTIVE_POLICY",
            "TEST_ONLY_ACTIVE_SIMULATION"
          ]
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "oracleType",
        "expectedInvariantIds",
        "allowedOutcomes",
        "prohibitedOutcomes",
        "expectedFinalDecision",
        "expectedTargetAction",
        "requiredBlockedReasons",
        "prohibitedActions",
        "executableOracleRefs"
      ],
      "properties": {
        "oracleType": {
          "enum": ["INVARIANT_ONLY", "PROVISIONAL_SEMANTIC", "DISAGREEMENT"]
        },
        "expectedInvariantIds": { "$ref": "#/$defs/codeList" },
        "allowedOutcomes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SUBSTANTIATED",
              "NOT_SUBSTANTIATED",
              "NOT_APPLICABLE",
              "UNASSESSABLE",
              "CONFLICTED",
              "POLICY_INVALID"
            ]
          }
        },
        "prohibitedOutcomes": {
          "type": "array",
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SUBSTANTIATED",
              "NOT_SUBSTANTIATED",
              "NOT_APPLICABLE",
              "UNASSESSABLE",
              "CONFLICTED",
              "POLICY_INVALID"
            ]
          }
        },
        "expectedFinalDecision": {
          "enum": ["RESOLVE", "REJECT", "NEEDS_MANUAL_REVIEW", "ANY_SAFE"]
        },
        "expectedTargetAction": {
          "enum": ["HIDE", "REMOVE", "KEEP_VISIBLE", "NO_ACTION", "ANY_SAFE"]
        },
        "requiredBlockedReasons": { "$ref": "#/$defs/codeList" },
        "prohibitedActions": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["HIDE", "REMOVE", "KEEP_VISIBLE", "NO_ACTION"] }
        },
        "executableOracleRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(CT-S2|SEM-S2|SCHEMA-S2|ADV|M07-FX|M08-FX|DATASET-S2)-[0-9]{2,3}$"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewerSource",
        "reviewerRefs",
        "reviewStatus",
        "disagreementStatus"
      ],
      "properties": {
        "reviewerSource": {
          "enum": [
            "SOURCE_CODE_CONTRACT",
            "POLICY_DOSSIER",
            "SYNTHETIC_PROVISIONAL",
            "MULTI_REVIEW_PENDING"
          ]
        },
        "reviewerRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "reviewStatus": {
          "enum": [
            "VERIFIED_INVARIANT",
            "PROVISIONAL_NOT_GROUND_TRUTH",
            "NEEDS_BUSINESS_REVIEW"
          ]
        },
        "disagreementStatus": { "enum": ["NONE", "OPEN", "RESOLVED"] }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "caseId",
        "datasetVersion",
        "caseClass",
        "targetType",
        "ruleFamily",
        "ruleId",
        "sanitizedReportClaim",
        "sanitizedTargetSnapshot",
        "evidenceBundleId",
        "missingRequirementIds",
        "counterEvidenceIds",
        "exceptionCodes",
        "profile",
        "oracle",
        "review",
        "versions",
        "notes"
      ],
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^S2EVAL-[0-9]{3}$"
        },
        "datasetVersion": { "const": "1.0.0-rc.1" },
        "caseClass": {
          "enum": ["HARD_SAFETY", "SEMANTIC_CANDIDATE", "DISAGREEMENT"]
        },
        "targetType": { "enum": ["BLOG", "COMMENT"] },
        "ruleFamily": { "$ref": "#/$defs/code" },
        "ruleId": { "$ref": "#/$defs/code" },
        "sanitizedReportClaim": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "sanitizedTargetSnapshot": { "$ref": "#/$defs/snapshot" },
        "evidenceBundleId": { "$ref": "#/$defs/code" },
        "missingRequirementIds": { "$ref": "#/$defs/codeList" },
        "counterEvidenceIds": { "$ref": "#/$defs/codeList" },
        "exceptionCodes": { "$ref": "#/$defs/codeList" },
        "profile": { "$ref": "#/$defs/profile" },
        "oracle": { "$ref": "#/$defs/oracle" },
        "review": { "$ref": "#/$defs/review" },
        "versions": { "$ref": "#/$defs/versions" },
        "notes": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
