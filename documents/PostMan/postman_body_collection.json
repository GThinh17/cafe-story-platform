  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Status is not server error', function () {",
          "  pm.expect(pm.response.code).to.be.below(500);",
          "});",
          "",
          "let json = {};",
          "try { json = pm.response.json(); } catch (e) {}",
          "const data = json.data || json;",
          "function save(name, value) { if (value) pm.collectionVariables.set(name, value); }",
          "save('user_id', data.userId || (data.user && data.user.userId));",
          "save('admin_id', data.adminId);",
          "save('blog_id', data.blogId || data.id);",
          "save('cafe_page_id', data.cafePageId || data.pageId);",
          "save('comment_id', data.commentId);",
          "save('conversation_id', data.conversationId || data.id);",
          "save('member_user_id', data.memberUserId);"
        ]
      }
    }
  ],
