    "name": "CafeStory Full API Collection - Cookie JWT",
    "description": "Full REST API collection generated from CafeStory Spring Boot controllers. Auth uses HttpOnly cookies from /api/auth/login, not Authorization Bearer. UUID values are symbolic variables for quick testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
