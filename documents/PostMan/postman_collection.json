  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response is not a server error', function () { pm.expect(pm.response.code).to.be.below(500); });",
          "let json = {}; try { json = pm.response.json(); } catch (e) {}",
          "const data = json.data || json;",
          "function save(name, value) { if (value) pm.environment.set(name, value); }",
          "const pathParts = (pm.request.url && pm.request.url.path) || [];",
          "const pathText = Array.isArray(pathParts) ? pathParts.join('/') : String(pathParts);",
          "save('user_id', data.userId || (data.user && data.user.userId));",
          "save('blog_id', data.blogId || (pathText.includes('blogs') ? data.id : null));",
          "save('cafe_page_id', data.cafePageId || data.pageId || (pathText.includes('cafe-pages') ? data.id : null));",
          "save('comment_id', data.commentId || (pathText.includes('comments') ? data.id : null));",
          "save('conversation_id', data.conversationId || (pathText.includes('conversations') ? data.id : null));",
          "save('notification_id', data.notificationId);",
          "save('reviewer_id', data.reviewerId);"
        ]
      }
    }
  ],
