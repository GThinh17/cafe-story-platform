        {
          "name": "Auth - Login and store cookies",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login success', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "pm.test('Set-Cookie contains access_token', function () { pm.expect(setCookie).to.include('access_token'); });",
                  "let json = {}; try { json = pm.response.json(); } catch (e) {}",
                  "const data = json.data || json;",
                  "if (data.user && data.user.userId) pm.environment.set('user_id', data.user.userId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"identifier\": \"auth.user.001@example.com\",\n  \"password\": \"123456\"\n}" },
            "url": "{{base_url}}/api/auth/login"
