            "body": { "mode": "raw", "raw": "{\n  \"userName\": \"auth_user_001\",\n  \"userFullName\": \"Auth User 001\",\n  \"password\": \"123456\",\n  \"userEmail\": \"auth.user.001@example.com\",\n  \"userPhone\": 901234567,\n  \"userAvatar\": \"https://example.com/avatar-auth-user.png\"\n}" },
            "url": "{{base_url}}/api/auth/register"
