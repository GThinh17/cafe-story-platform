flowchart TD
    Start(["Admin bắt đầu xử lý report bằng AI"])

    Start --> A["POST /api/admin/reports/{reportId}/ai-resolution"]
    A --> B["BE validate reportId không null"]
    B --> C["Find ContentReport theo reportId"]
    C --> D{"Report tồn tại?"}

    D -->|"Không"| E["Return 404 Report not found"]
    D -->|"Có"| F["Load report detail<br/>targetType, targetId, reason<br/>description, status"]

    F --> G{"Target type là gì?"}
    G -->|"BLOG"| H["Build BLOG context<br/>blog content + imageUrls"]
    G -->|"COMMENT"| I["Build COMMENT context<br/>comment content + imageUrls"]
    G -->|"USER"| J["Build USER context<br/>username, fullName, description, avatar<br/>không gửi password/email nhạy cảm"]
    G -->|"CAFE_PAGE"| K["Build CAFE_PAGE context<br/>name, address, description<br/>avatarUrl, coverUrl"]

    H --> L["Load optional existingModerationResult<br/>từ AiModerationResult theo contentReportId"]
    I --> L
    J --> L
    K --> L

    L --> M["Compute sameTargetOpenReportCount<br/>OPEN/REVIEWING trên cùng target"]
    M --> N["Build n8n payload<br/>reportId, targetType, targetId<br/>reasonCode, reasonLabel, reasonSeverity<br/>description, contentText, imageUrls<br/>reportStatus, existingModerationResult<br/>sameTargetOpenReportCount"]

    N --> O["Call n8n webhook sync<br/>/cafestory-admin-report-ai-resolution<br/>timeout = ADMIN_REPORT_AI_TIMEOUT_MS"]

    O --> P["n8n validate required fields"]
    P --> Q{"Payload hợp lệ?"}
    Q -->|"Không"| R["n8n throw error<br/>BE return 502 Bad Gateway<br/>không save recommendation"]

    Q -->|"Có"| S["n8n build decision prompt<br/>rule source of truth nằm trong n8n"]
    S --> T["n8n gọi OpenAI Responses API<br/>model = gpt-4o-mini<br/>structured output JSON"]
    T --> U["OpenAI trả recommendation JSON"]

    U --> V["n8n normalize response<br/>clamp confidenceScore/riskScore 0..100<br/>validate targetAction theo targetType"]
    V --> W{"targetAction hợp lệ?"}
    W -->|"Không"| X["Fallback<br/>reportDecision = NEEDS_MANUAL_REVIEW<br/>targetAction = NONE<br/>ruleCode = INVALID_ACTION_FALLBACK"]
    W -->|"Có"| Y["Giữ recommendation từ AI"]

    X --> Z["Return fixed JSON contract về BE"]
    Y --> Z

    Z --> AA{"BE parse + validate response OK?"}
    AA -->|"Không"| AB["Return 502 Bad Gateway<br/>không mutate report/content<br/>không save recommendation"]

    AA -->|"Có"| AC["Save AdminReportAiResolution<br/>contentReportId, targetType, targetId<br/>reportDecision, targetAction<br/>confidenceScore, riskScore, labels<br/>ruleCode, explanation, modelName, rawResponse"]

    AC --> AD["Return AdminReportAiResolutionResponseDTO"]
    AD --> AE["Admin xem recommendation"]

    AE --> AF{"Admin chọn làm gì?"}
    AF -->|"Chưa chắc"| AG["Manual review tiếp<br/>không đổi report/content"]
    AF -->|"Chỉ đóng report"| AH["Admin gọi report resolve riêng<br/>POST /api/admin/reports/{reportId}/resolve"]
    AF -->|"Xử lý moderation result"| AI["Admin dùng moderation resolve riêng<br/>POST /api/admin/moderation/results/{resultId}/resolve"]

    AG --> AJ["GET /api/admin/reports/{reportId}/ai-resolutions<br/>xem lịch sử AI recommendation"]
    AH --> AJ
    AI --> AJ

    AJ --> End(["Kết thúc flow AI resolution"])
